{
  "name": "phone-remote",
  "productName": "Phone Remote",
  "version": "0.1.1",
  "private": true,
  "description": "Control this laptop from your phone over Wi-Fi.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:web": "npm --prefix ../backend run build:web",
    "pack": "electron-builder --win --dir",
    "dist": "npm run build:web && electron-builder --win"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "remote-app-backend": "file:../backend"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "author": "Joshua Ozibo",
  "homepage": "https://github.com/JoshuaOzibo/Remote-control-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshuaOzibo/Remote-control-app.git"
  }
}
